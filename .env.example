NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role 키 — 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
# Vercel 등 배포 환경의 "서버 전용" 환경변수로만 설정하고, 로컬 .env.local에도
# 실제 값을 커밋하지 않는다. lib/supabase-admin.ts에서만 사용하며, RLS를
# 완전히 우회하므로 신뢰할 수 있는 서버 라우트(google-form-sync 등,
# 시크릿 헤더 검증 통과 후)에서만 사용한다. 유출 시 Supabase Dashboard에서
# 즉시 키를 회전(rotate)한다.
SUPABASE_SERVICE_ROLE_KEY=

GOOGLE_FORM_SYNC_SECRET=
ADMIN_EMAILS=

# 간병인 인증(Solapi SMS OTP + 자체 장기 세션) — 자세한 내용은
# docs/solapi-caregiver-auth.md 참고. 모두 서버 전용 변수이며
# NEXT_PUBLIC_ 접두사를 붙이지 않는다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_NUMBER=

# 세션 토큰 해시(HMAC-SHA256)와 OTP 코드 해시에 사용하는 서버 전용 시크릿.
# 최소 32바이트 이상의 무작위 값을 권장하며, 유출 시 즉시 교체하고 기존
# caregiver_sessions를 모두 폐기해야 한다.
CAREGIVER_SESSION_SECRET=
