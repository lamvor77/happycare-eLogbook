NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role 키 — 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
# Vercel 등 배포 환경의 "서버 전용" 환경변수로만 설정하고, 로컬 .env.local에도
# 실제 값을 커밋하지 않는다. lib/supabase-admin.ts에서만 사용하며, RLS를
# 완전히 우회하므로 신뢰할 수 있는 서버 라우트(google-form-sync 등,
# 시크릿 헤더 검증 통과 후)에서만 사용한다. 유출 시 Supabase Dashboard에서
# 즉시 키를 회전(rotate)한다.
SUPABASE_SERVICE_ROLE_KEY=

GOOGLE_FORM_SYNC_SECRET=
ADMIN_EMAILS=

# 전자일지 ↔ 기존 가족간병관리 시스템 연동(lib/legacy-sync.ts, lib/
# legacy-registration-options.ts, docs/legacy-sync-integration.md).
# GOOGLE_FORM_SYNC_SECRET과는 별개 용도이며 값도 반드시 다르게 설정한다.
# 두 URL 모두 운영팀이 기존 시스템(Apps Script) 쪽에 별도로 구축/배포하는
# 엔드포인트 주소다(이 저장소에는 그 수신/조회 측 구현이 없다).
LEGACY_FAMILYCARE_WEBHOOK_URL=
LEGACY_FAMILYCARE_WEBHOOK_SECRET=

# 기존 Google Form의 "보험사"(및 사고유형) 현재 선택지를 조회하는 엔드포인트.
# 등록 화면이 보험사 목록을 하드코딩하지 않고 매번 이 값을 통해 받아온다
# (작업 15~19). 미설정 시 보험사 목록은 빈 배열로 내려간다(사고유형은 고정
# 값으로 대체됨).
LEGACY_FAMILYCARE_CONFIG_URL=

# 간병인 인증(Solapi SMS OTP + 자체 장기 세션) — 자세한 내용은
# docs/solapi-caregiver-auth.md 참고. 모두 서버 전용 변수이며
# NEXT_PUBLIC_ 접두사를 붙이지 않는다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_NUMBER=

# 세션 토큰 해시(HMAC-SHA256)와 OTP 코드 해시에 사용하는 서버 전용 시크릿.
# 최소 32바이트 이상의 무작위 값을 권장하며, 유출 시 즉시 교체하고 기존
# caregiver_sessions를 모두 폐기해야 한다.
CAREGIVER_SESSION_SECRET=

# 간병인 주민등록번호(전체 13자리) AES-256-GCM 암호화 키. base64로 인코딩된
# 32바이트 값(예: `openssl rand -base64 32`로 생성). 서버 전용이며 절대
# NEXT_PUBLIC_ 접두사를 붙이지 않는다. lib/caregiver-resident-number.ts
# 에서만 사용한다. CAREGIVER_SESSION_SECRET과 다른 별도의 값을 쓸 것 —
# 용도가 다르면 키도 분리해, 하나가 유출돼도 다른 하나는 안전하게 유지한다.
# 실제 키 값은 이 파일/문서/커밋 어디에도 남기지 않는다. 유출 시 즉시
# 교체하고(키 회전은 lib/caregiver-resident-number.ts의 key_version 필드로
# 지원), 기존 암호화 데이터의 재암호화 절차를 별도로 계획한다.
CAREGIVER_RRN_ENCRYPTION_KEY=
